# ─── Database ────────────────────────────────────────────────────────────────
# Get this from your Supabase project → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# ─── JWT Secrets (generate with: node -e "require('crypto').randomBytes(64).toString('hex')|head -c 64")
# These MUST be at least 32 characters long
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Development Auth Bypass ──────────────────────────────────────────────────
# Set to true to skip real Firebase and use dev:+91XXXXXXXXXX tokens
# DEV accounts: Customer +919999999901, Driver +919999999902, Admin +919999999900
# OTP for dev: 123456
DEV_BYPASS_AUTH=true
DEV_OTP=123456

# ─── Firebase Admin (Required for production; not needed if DEV_BYPASS_AUTH=true)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# ─── Razorpay (Optional — mock payments work without these)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Google Maps (Optional — map features need this)
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
